generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String        @id @default(cuid())
  name         String
  type         AccountType   @default(BANK)
  initialCents Int           @default(0)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id          String           @id @default(cuid())
  accountId   String
  amountCents Int
  description String
  category    String?
  occurredAt  DateTime
  recurringId String?
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
}

model RecurringExpense {
  id           String        @id @default(cuid())
  name         String
  amountCents  Int
  frequency    Frequency
  nextDate     DateTime
  active       Boolean       @default(true)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

enum AccountType {
  BANK
  CASH
  CARD
  SAVINGS
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}
